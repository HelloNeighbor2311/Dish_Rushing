%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d380368c6bf6c1f4caba68a9f70de7d5, type: 3}
  m_Name: OwnerDialogue
  m_EditorClassIdentifier: Assembly-CSharp::OwnerDialogueSO
  speakerName: "B\xE0 ch\u1EE7"
  portrait: {fileID: -5865535658389170615, guid: 55bab8036c8cbac45abed35943450ec1, type: 3}
  welcome:
  - "\u0110\xE2y l\xE0 giang s\u01A1n c\u1EE7a ch\u1ECB. Kh\xE1ch \u0111\xF4ng nh\u01B0
    ki\u1EBFn, b\xE1t nhi\u1EC1u nh\u01B0 sao tr\xEAn tr\u1EDDi."
  - "C\xF2n em l\xE0 nh\xE2n vi\xEAn r\u1EEDa b\xE1t, ki\xEAm b\u01B0ng b\xEA, ki\xEAm
    lau b\xE0n, ki\xEAm\u2026 n\xF3i chung l\xE0 ki\xEAm."
  - "Ch\u1ECB ch\u1EC9 d\u1EA1y m\u1ED9t l\u1EA7n. Nh\u1EDB th\xEC l\xE0m. Qu\xEAn
    th\xEC\u2026 ch\u1ECB nh\u1EAFc. Nh\u01B0ng ch\u1ECB nh\u1EAFc b\u1EB1ng gi\u1ECDng
    to."
  startShift:
  - "\u0110\u01B0\u1EE3c \u0111\u1EA5y, c\xF3 t\u1ED1 ch\u1EA5t! Ch\u1ECB nh\xECn
    ng\u01B0\u1EDDi \xEDt khi sai, tr\u1EEB con Linh."
  - "Gi\u1EDD ch\u1ECB b\u1EADt \u0111\u1ED3ng h\u1ED3. R\u1EEDa h\u1EBFt b\xE1t
    tr\u01B0\u1EDBc khi v\u1EC1 0. Kh\xE1ch \u0103n xong l\xE0 c\xF3 b\xE1t, nhanh
    tay l\xEAn."
  - "M\u1EC7t th\xEC \u0111\u1EE9ng y\xEAn l\u1EA5y s\u1EE9c. Esc \u0111\u1EC3 ngh\u1EC9\u2026
    nh\u01B0ng \u0111\u1EEBng ngh\u1EC9 l\xE2u, ch\u1ECB \u0111\u1EE9ng qu\u1EA7y
    nh\xECn th\u1EA5y h\u1EBFt."
  - "L\xE0m t\u1ED1t cu\u1ED1i th\xE1ng ch\u1ECB th\u01B0\u1EDFng\u2026 m\u1ED9t
    l\u1EDDi khen th\u1EADt l\xF2ng. C\xF3 khi c\xF2n h\u01A1n: hai l\u1EDDi khen.
    V\xE0o ca!"
  stepObjectives:
  - "Nghe b\xE0 ch\u1EE7 \"truy\u1EC1n \u0111\u1EA1t kinh nghi\u1EC7m\""
  - "\u0110i m\u1ED9t v\xF2ng b\u1EB1ng WASD cho quen ch\xE2n"
  - "Ra b\xE0n c\xF3 b\xE1t, nh\u1EA5n E \u0111\u1EC3 nh\u1EB7t (nh\u1EB9 tay!)"
  - "\u0110\u1EC3 \xFD thanh th\u1EC3 l\u1EF1c: b\xEA nhi\u1EC1u l\xE0 m\u1EC7t,
    m\u1EC7t qu\xE1 l\xE0 XO\u1EA2NG"
  - "Mang b\xE1t v\xE0o b\u1EBFp, nh\u1EA5n E \u1EDF b\u1ED3n r\u1EEDa"
  - "Gi\u1EEF chu\u1ED9t tr\xE1i v\xE0 ch\xE0 cho \u0111\u0129a s\u1EA1ch b\xF3ng"
  - "Nghe d\u1EB7n d\xF2 l\u1EA7n cu\u1ED1i r\u1ED3i v\xE0o ca"
  stepIntro:
  - "\u0110i m\u1ED9t v\xF2ng cho quen ch\xE2n. WASD \u1EA5y. \u0110\u1EEBng h\u1ECFi
    WASD l\xE0 g\xEC, c\u1EE9 b\u1EA5m l\xE0 bi\u1EBFt."
  - "Th\u1EA5y ch\u1ED3ng b\xE1t tr\xEAn b\xE0n kia kh\xF4ng? Ra nh\u1EB7t v\u1EC1.
    \u0110\u1EE9ng s\xE1t b\xE0n, nh\u1EA5n E, nh\u1EB9 tay!"
  - "B\xEA c\xE0ng nhi\u1EC1u c\xE0ng m\u1EC7t. M\u1EC7t qu\xE1 l\xE0\u2026 XO\u1EA2NG!
    Thanh th\u1EC3 l\u1EF1c \u1EDF g\xF3c tr\xEAn \u1EA5y, nh\xECn m\xE0 li\u1EC7u
    s\u1EE9c."
  - "Gi\u1EDD mang v\xE0o b\u1EBFp. B\u1ED3n r\u1EEDa \u1EDF cu\u1ED1i b\u1EBFp,
    c\u1EA1nh ch\u1ED7 ch\xFA T\u01B0 \u0111ang\u2026 \xE0 ch\xFA \u1EA5y ngh\u1EC9
    tr\u01B0a t\u1EEB s\xE1ng."
  - "Gi\u1EEF chu\u1ED9t tr\xE1i r\u1ED3i ch\xE0. Ch\xE0 nh\u01B0 ch\xE0 n\u1ED7i
    bu\u1ED3n \u1EA5y."
  stepIdle:
  - lines:
    - "Em \u0111\u1EE9ng \u0111\u1EA5y l\xE0m t\u01B0\u1EE3ng \xE0? Qu\xE1n ch\u1ECB
      kh\xF4ng thi\u1EBFu t\u01B0\u1EE3ng."
    - "\u0110i \u0111i em. Ch\xE2n \u0111\u1EC3 \u0111i, kh\xF4ng ph\u1EA3i \u0111\u1EC3
      trang tr\xED."
    - "Ch\u1ECB \u0111\u1EBFm \u0111\u1EBFn ba nh\xE9. M\u1ED9t\u2026 hai\u2026 ch\u1ECB
      tr\u1EEB l\u01B0\u01A1ng nh\xE9."
  - lines:
    - "B\xE0n c\xF3 m\u0169i t\xEAn v\xE0ng \u1EA5y. To nh\u01B0 th\u1EBF m\xE0 kh\xF4ng
      th\u1EA5y \xE0?"
    - "\u0110\u1EE9ng s\xE1t v\xE0o b\xE0n r\u1ED3i nh\u1EA5n E. B\xE1t kh\xF4ng
      t\u1EF1 bay v\u1EC1 \u0111\xE2y \u0111\xE2u em."
    - "Ng\xE0y x\u01B0a ch\u1ECB nh\u1EB7t b\xE1t b\u1EB1ng m\u1ED9t tay, tay kia
      c\xF2n t\xEDnh ti\u1EC1n cho kh\xE1ch."
  - lines: []
  - lines:
    - "B\u1EBFp \u1EDF b\xEAn ph\u1EA3i. \u0110i theo m\u0169i t\xEAn. M\u0169i t\xEAn
      ch\u1ECB thu\xEA ri\xEAng cho em \u0111\u1EA5y."
    - "B\xE1t tr\xEAn tay m\xE0 \u0111\u1EE9ng l\xE2u l\xE0 m\u1ECFi \u0111\u1EA5y.
      M\u1ECFi l\xE0 r\u01A1i. R\u01A1i l\xE0\u2026 em bi\u1EBFt r\u1ED3i."
    - "H\u1ED3i tr\u1EBB ch\u1ECB ch\u1EA1y t\u1EEB qu\u1EA7y v\xE0o b\u1EBFp m\u1EA5t
      3 gi\xE2y. Em \u0111ang m\u1EA5t 3 ph\xFAt."
  - lines:
    - "Gi\u1EEF chu\u1ED9t tr\xE1i r\u1ED3i di \u0111i em. Ch\xE0 nh\u01B0 ch\xE0
      n\u1ED7i bu\u1ED3n \u1EA5y."
    - "Ch\xE0 m\u1EA1nh l\xEAn, v\u1EBFt b\u1EA9n n\xE0y n\xF3 \u1EDF v\u1EDBi ch\u1ECB
      t\u1EEB tr\u01B0a r\u1ED3i."
    - "B\u1EA5m XONG l\xE0 n\u1ED9p. Nh\u01B0ng n\u1ED9p b\xE1t b\u1EA9n l\xE0 ch\u1ECB
      tr\u1EEB ti\u1EC1n \u0111\u1EA5y nh\xE9."
  stepCompleted:
  - "\u0110i \u0111\u1EE9ng ra d\xE1ng \u0111\u1EA5y. Ch\xE2n tay l\xE0nh l\u1EB7n,
    ch\u1ECB \u0111\u1EE1 ph\u1EA3i \u0111\xF3ng b\u1EA3o hi\u1EC3m."
  - "C\u1EA7m b\xE1t nh\u01B0 c\u1EA7m v\xE0ng nh\xE9 em. V\xE0ng th\u1EADt \u0111\u1EA5y,
    ch\u1ECB mua t\u1EEB h\u1ED3i m\u1EDF qu\xE1n."
  - "Nh\u1EDB ch\u01B0a? V\u1EE1 c\xE1i n\xE0o, tr\u1EEB l\u01B0\u01A1ng c\xE1i \u0111\xF3.
    Ch\u1ECB c\xF3 s\u1ED5, ch\u1ECB ghi r\u1EA5t \u0111\u1EB9p."
  - "Gi\u1ECFi! Gi\u1EDD th\xEC ch\xE0. B\u1ECDt bi\u1EC3n ch\u1ECB mua lo\u1EA1i
    x\u1ECBn, 5 ngh\xECn ba c\xE1i."
  - "\u01A0, s\u1EA1ch b\xF3ng! Ki\u1EBFp tr\u01B0\u1EDBc em l\xE0 m\xE1y r\u1EEDa
    b\xE1t \xE0?"
  scrubDirtyReaction: "B\xE1t th\u1EBF n\xE0y m\xE0 \u0111\u01B0a kh\xE1ch, kh\xE1ch
    \u0111\u01B0a ch\u1ECB l\xEAn b\xE1o! Th\xF4i, l\u1EA7n sau ch\xE0 k\u1EF9."
  dishBrokenDuringTutorial:
  - "Ch\u01B0a c\u1EA7m \u0111\xE3 v\u1EE1?! Ch\u1ECB l\u1EA5y ch\u1ED3ng kh\xE1c.
    C\xE1i n\xE0y ch\u1ECB ghi s\u1ED5."
  - "\u0110\u1EA5y! Ch\u1ECB v\u1EEBa d\u1EB7n xong! Ra l\u1EA5y ch\u1ED3ng kh\xE1c.
    L\u1EA7n n\xE0y \u0111i ch\u1EADm th\xF4i."
  talkPrompts:
  - "G\xEC \u0111\u1EA5y? H\u1ECFi nhanh, kh\xE1ch \u0111ang ch\u1EDD."
  - "L\u1EA1i g\xEC n\u1EEFa? B\xE1t r\u1EEDa xong ch\u01B0a m\xE0 l\xEAn \u0111\xE2y?"
  - "N\xF3i \u0111i, ch\u1ECB nghe. Nh\u01B0ng n\xF3i ng\u1EAFn th\xF4i, n\xF3i d\xE0i
    ch\u1ECB t\xEDnh ph\xED."
  - "Em l\xEAn \u0111\xE2y l\xE0 c\xF3 chuy\u1EC7n hay ch\u1EC9 mu\u1ED1n ng\u1EAFm
    ch\u1ECB?"
  talkOptions:
  - "Ch\u1ECB cho em xin b\xED k\xEDp"
  - "Ch\u1ECB d\u1EA1y l\u1EA1i t\u1EEB \u0111\u1EA7u \u0111i \u1EA1"
  tips:
  - "\u0110\u1EE9ng y\xEAn m\u1ED9t ch\xFAt l\xE0 h\u1ED3i s\u1EE9c. \u0110\u1EE9ng
    l\xE2u qu\xE1 th\xEC ch\u1ECB h\u1ED3i\u2026 c\xE1i l\u01B0\u01A1ng."
  - "B\xEA nhi\u1EC1u th\xEC \u0111i ch\u1EADm. Tham b\xE1t l\xE0 v\u1EE1 b\xE1t.
    V\u1EE1 b\xE1t l\xE0\u2026 em t\u1EF1 hi\u1EC3u."
  - "Ch\xE0 s\u1EA1ch 100% l\xE0 t\u1EF1 xong, kh\u1ECFi b\u1EA5m. Ch\u1ECB th\xEDch
    ng\u01B0\u1EDDi t\u1EF1 gi\xE1c."
  - "B\xE1t b\u1EA9n ch\u1ECB tr\u1EEB ti\u1EC1n. B\xE1t v\u1EE1 ch\u1ECB tr\u1EEB
    ti\u1EC1n. B\xE1t s\u1EA1ch\u2026 ch\u1ECB xem x\xE9t."
  - "B\u1ED3n r\u1EEDa nh\u1EADn h\u1EBFt b\xE1t em c\u1EA7m m\u1ED9t l\u1EA7n. \u0110i
    m\u1ED9t chuy\u1EBFn cho \u0111\xE1ng, x\u0103ng xe \u0111\u1EAFt l\u1EAFm."
  - "Kh\xE1ch \u0103n xong m\u1EDBi c\xF3 b\xE1t. \u0110\u1EEBng gi\u1EADt b\xE1t
    khi kh\xE1ch \u0111ang \u0103n, ch\u1ECB m\u1EA5t kh\xE1ch \u0111\u1EA5y."
  - "Nh\xECn s\u1ED1 'C\u1EA7n R\u1EEDa' \u1EDF g\xF3c tr\xEAn. S\u1ED1 \u0111\xF3
    b\u1EB1ng 0 l\xE0 ch\u1ECB vui. Ch\u1ECB vui th\xEC\u2026 v\u1EABn th\u1EBF th\xF4i."
  - "Thanh th\u1EDDi gian v\u1EC1 0 m\xE0 c\xF2n b\xE1t l\xE0 ch\u1ECB bu\u1ED3n.
    Ch\u1ECB bu\u1ED3n th\xEC c\u1EA3 qu\xE1n c\xF9ng bu\u1ED3n."
  tipsEasterEgg: "Em h\u1ECFi nhi\u1EC1u th\u1EBF, \u0111\u1ECBnh m\u1EDF qu\xE1n
    c\u1EA1nh tranh v\u1EDBi ch\u1ECB \xE0?"
  replayAck: "L\u1EA1i qu\xEAn r\u1ED3i \xE0? Th\xF4i \u0111\u01B0\u1EE3c, ch\u1ECB
    d\u1EA1y l\u1EA1i. L\u1EA7n n\xE0y nh\u1EDB th\xEC ch\u1ECB\u2026 kh\xF4ng tr\u1EEB
    l\u01B0\u01A1ng bu\u1ED5i h\u1ECDc."
  barkBroken:
  - "XO\u1EA2NG! Tr\u1EEB l\u01B0\u01A1ng!"
  - "B\xE1t \u0111\u1EA5y ch\u1ECB mua b\u1EB1ng v\xE0ng \u0111\u1EA5y \xE0 m\xE0
    em qu\u0103ng?"
  - "Th\xEAm c\xE1i n\u1EEFa l\xE0 ch\u1ECB g\u1ECDi v\u1EC1 cho m\u1EB9 em!"
  - "C\xE1i b\xE1t \u1EA5y theo ch\u1ECB t\u1EEB h\u1ED3i ch\u1ECB c\xF2n con g\xE1i\u2026"
  - "V\u1EE1 th\xEC qu\xE9t \u0111i. R\u1ED3i ghi s\u1ED5. Ghi \u0111\u1EB9p v\xE0o."
  barkDirty:
  - "R\u1EEDa th\u1EBF m\xE0 g\u1ECDi l\xE0 s\u1EA1ch \xE0?"
  - "V\u1EBFt b\u1EA9n c\xF2n to h\u01A1n t\u01B0\u01A1ng lai c\u1EE7a em \u0111\u1EA5y!"
  - "Kh\xE1ch m\xE0 nh\xECn th\u1EA5y l\xE0 kh\xE1ch b\u1ECF v\u1EC1 \u0103n qu\xE1n
    b\xEAn kia!"
  - "Ch\xE0 l\u1EA1i! \xC0 kh\xF4ng, tr\u1EEB ti\u1EC1n r\u1ED3i, l\u1EA7n sau ch\xE0
    k\u1EF9."
  barkPileUp:
  - "B\xE1t ch\u1EA5t nh\u01B0 n\xFAi r\u1ED3i k\xECa! Leo l\xEAn m\xE0 ng\u1EAFm
    c\u1EA3nh \xE0?"
  - "Kh\xE1ch s\u1EAFp ph\u1EA3i \u0103n b\u1EB1ng tay r\u1ED3i \u0111\u1EA5y em
    \u01A1i!"
  - "Nhanh l\xEAn! Ch\u1ECB h\u1EBFt b\xE1t, ch\u1ECB ph\u1EA3i m\xFAc ph\u1EDF v\xE0o
    m\u0169 b\u1EA3o hi\u1EC3m \xE0?"
  barkTimeLow:
  - "S\u1EAFp h\u1EBFt ca r\u1ED3i! Nhanh c\xE1i tay l\xEAn!"
  - "C\xF2n m\u1EA5y gi\xE2y th\xF4i, ch\u1EA1y \u0111i em \u01A1i!"
  - "\u0110\u1ED3ng h\u1ED3 kh\xF4ng ch\u1EDD ai \u0111\xE2u. Ch\u1ECB c\u0169ng
    kh\xF4ng ch\u1EDD."
  barkCleanStreak:
  - "Ngoan, cu\u1ED1i th\xE1ng ch\u1ECB th\u01B0\u1EDFng!"
  - "\u0110\u1EA5y, ch\u0103m th\u1EBF c\xF3 ph\u1EA3i t\u1ED1t kh\xF4ng."
  - "C\u1EE9 th\u1EBF n\xE0y ch\u1ECB cho em l\xEAn\u2026 r\u1EEDa n\u1ED3i."
  - "Nhanh tay \u0111\u1EA5y. Ch\u1ECB ch\u01B0a k\u1ECBp ngh\u0129 ra c\xE2u m\u1EAFng."
  - "Th\xF4i \u0111\u01B0\u1EE3c, h\xF4m nay ch\u1ECB kh\xF4ng m\u1EAFng. Mai ch\u1ECB
    m\u1EAFng b\xF9."
  winShift:
  - "H\u1EBFt b\xE1t r\u1ED3i \xE0? S\u1EDBm th\u1EBF? \u2026Ch\u1EAFc t\u1EA1i h\xF4m
    nay kh\xE1ch \u0103n \xEDt."
  - "\u0110\u01B0\u1EE3c, mai \u0111i l\xE0m s\u1EDBm 15 ph\xFAt. Ph\u1EA7n th\u01B0\u1EDFng
    c\u1EE7a s\u1EF1 xu\u1EA5t s\u1EAFc \u0111\u1EA5y."
  loseTime: "H\u1EBFt gi\u1EDD m\xE0 b\xE1t c\xF2n nguy\xEAn \u0111\u1EA5y. Ch\u1ECB
    kh\xF4ng n\xF3i g\xEC \u0111\xE2u. Ch\u1ECB ch\u1EC9 ghi s\u1ED5 th\xF4i."
  loseBroken: "Em l\xE0 nh\xE2n vi\xEAn r\u1EEDa b\xE1t hay nh\xE2n vi\xEAn \u0111\u1EADp
    b\xE1t? V\u1EC1 ngh\u1EC9 \u0111i, mai l\xE0m l\u1EA1i."
  chefEndShift: "\u0102n t\u1EA1m b\xE1t c\u01A1m \u0111i ch\xE1u. \u0110\u1EEBng
    \u0111\u1EC3 b\xE0 \u1EA5y bi\u1EBFt l\xE0 ch\xFA cho th\xEAm tr\u1EE9ng."
